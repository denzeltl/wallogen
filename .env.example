# Copy to .env.local (never commit real keys).

# Primary Provider: Free Groq API key from https://console.groq.com/keys (14,400 free requests/day, sub-second latency)
# Server-only: read by src/app/api/ai/generate/route.ts. Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=

# Optional. Defaults to "llama-3.1-8b-instant"
# GROQ_MODEL=llama-3.1-8b-instant

# Secondary Provider: Free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to "gemini-2.5-flash"
# GEMINI_MODEL=gemini-2.5-flash
