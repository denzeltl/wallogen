# Copy to .env.local (never commit real keys).

# Free Gemini API key from https://aistudio.google.com/apikey
# Server-only: read by src/app/api/ai/generate/route.ts. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Optional. Defaults to "gemini-flash-lite-latest", which tracks Google's current free-tier Flash-Lite model.
# GEMINI_MODEL=gemini-flash-lite-latest
